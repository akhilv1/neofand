[Unit]
Description=NeoCharge read-only hardware API
After=network.target
[Service]
User=neofand
Group=neofand
Environment=NEOFAND_DATA_DIR=/var/lib/neofand/telemetry
Environment=NEOFAND_BIND=127.0.0.1
Environment=NEOFAND_PORT=4792
ExecStart=/usr/bin/python3 -B /opt/neofand/linux_api.py
Restart=on-failure
NoNewPrivileges=true
UMask=0077
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources connect
TasksMax=16
MemoryMax=128M
CPUQuota=75%
LimitNOFILE=256
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:4792
SocketBindAllow=ipv6:tcp:4792
[Install]
WantedBy=multi-user.target
