[Unit]
Description=Categorize storage for the hardware dashboard (metadata only)
After=neofand-storage.service

[Service]
Type=oneshot
User=neo
ExecStart=/usr/bin/python3 -B /home/neo/services/neofand-dashboard/storage_breakdown.py /home/neo/services/neofand-dashboard/telemetry/storage.json /home/neo/services/neofand-dashboard/telemetry/storage-breakdown.json
Nice=19
IOSchedulingClass=idle
CPUQuota=50%
MemoryMax=512M
TimeoutStartSec=20min
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/neo/services/neofand-dashboard/telemetry
