{
    admin off
    auto_https off
}
:8080 {
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy no-referrer
    }
    @apiGet {
        path /api/*
        method GET
    }
    handle @apiGet {
        reverse_proxy telemetry:8080
    }
    handle /api/* {
        respond "Method not allowed" 405
    }
    handle {
        root * /srv
        file_server
    }
}
