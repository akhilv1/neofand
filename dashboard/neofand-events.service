[Unit]
Description=Read-only Ubuntu events for the hardware dashboard
After=systemd-journald.service

[Service]
Type=oneshot
User=neo
ExecStart=/usr/bin/python3 -B /home/neo/services/neofand-dashboard/system_events.py /home/neo/services/neofand-dashboard/telemetry/system-events.json
TimeoutStartSec=90
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ReadWritePaths=/home/neo/services/neofand-dashboard/telemetry
